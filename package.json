{
  "name": "pxg_offline_platform",
  "productName": "pXg-GUI",
  "version": "1.0.0",
  "main": "main.js",
  "type": "module",
  "author": "ZSJ",
  "description": "pXg offline app",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dir --arm64",
    "pack:mac:zip": "electron-builder --mac dir,zip --arm64",
    "pack:mac:dmg": "electron-builder --mac dir,dmg --arm64",
    "pack:mac:universal": "electron-builder --mac dir,zip --universal",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.example.pxgoffline",
    "productName": "pXg-GUI",
    "asar": true,
    "asarUnpack": ["bin/**/*"],
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "execution.html",
      "result_page.html",
      "main.js",
      "preload.js",
      "package.json",
      "icon/**/*",
      "css/**/*",
      "js/**/*"
    ],
    "extraResources": [
      { "from": "bin", "to": "bin" } 
    ],
    "mac": {
      "target": [ "dir" ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.ico",
      "hardenedRuntime": false,  
      "gatekeeperAssess": false
    },

    "dmg": {
      "background": null,       
      "sign": false           
    },

    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "pXg-GUI-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12"
  }
}