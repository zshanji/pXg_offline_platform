{
  "name": "pxg-offline",
  "version": "1.0.0",
  "main": "main.js",
  "type":"module",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dir"   
  },
  "build": {
    "appId": "com.example.pxgoffline",
    "asar": true,
    "files": [
      "index.html",
      "execution.html",
      "result_page.html",
      "main.js",
      "preload.js",
      "package.json",
      "icon/**/*",
      "css/**/*",
      "js/**/*"
    ],
    "mac": {
      "target": "dir",                          
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "background": null                       
    }
  },
  "devDependencies": {
    "electron": "^37.3.0",
    "electron-builder": "^26.0.12"
  }
}